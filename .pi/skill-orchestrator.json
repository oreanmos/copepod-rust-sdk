{
  "$comment": [
    "skill-orchestrator map for the Oikonotes / Copepod / copepod-rust-sdk flow.",
    "Applies to any pi session started in this repo, including dispatches into",
    "copepod worktrees (the session's repo decides the map).",
    "Scheme: zai-glm-5-3 orchestrates (session model) and plans (high);",
    "gpt-6-luna implements (medium, matching .codex/agents; bump for",
    "heavyweight slices) and does grunt work (medium); mistral-large-4",
    "reviews (high) and owns cybersecurity analysis - the security role",
    "plus the secur|cyber|threat name hint route security-flavoured dispatches",
    "to it. mistral-large-4 sees images, so the reviewer can LOOK at",
    "screenshots directly; glm-5-3 stays text-only: scouts capture them via",
    "scripts and report them as paths."
  ],
  "roles": {
    "planning": {
      "model": "mistral/zai-glm-5-3",
      "thinking": "high",
      "requires": [
        "reasoning"
      ]
    },
    "implementation": {
      "model": "openai-codex/gpt-6-luna",
      "thinking": "medium",
      "requires": [
        "reasoning"
      ]
    },
    "grunt": {
      "model": "openai-codex/gpt-6-luna",
      "thinking": "medium",
      "requires": []
    },
    "review": {
      "model": "mistral/mistral-large-4",
      "thinking": "high",
      "requires": [
        "reasoning",
        "image"
      ]
    },
    "security": {
      "model": "mistral/mistral-large-4",
      "thinking": "high",
      "requires": [
        "reasoning",
        "image"
      ],
      "tools": "read,bash,ls,find,grep"
    },
    "scout": {
      "model": "mistral/zai-glm-5-3",
      "thinking": "medium",
      "requires": []
    },
    "orchestration": {
      "model": null,
      "thinking": null,
      "requires": []
    }
  },
  "skills": {
    "oiko-plan": {
      "role": "planning"
    },
    "oiko-contract": {
      "role": "planning"
    },
    "oiko-build": {
      "role": "orchestration"
    },
    "oiko-implement": {
      "role": "implementation"
    },
    "oiko-review": {
      "role": "review"
    },
    "oiko-worktree": {
      "role": "orchestration"
    },
    "oikonotes-dev": {
      "role": "grunt"
    },
    "copepod-dev": {
      "role": "grunt"
    },
    "copepod-sdk-dev": {
      "role": "grunt"
    }
  },
  "agents": {
    "oiko-implementer": {
      "role": "implementation",
      "tools": "read,edit,write,bash,ls,find,grep"
    },
    "oiko-reviewer": {
      "role": "review",
      "tools": "read,bash,ls,find,grep"
    },
    "oiko-scout": {
      "role": "scout",
      "tools": "read,bash,ls,find,grep"
    }
  },
  "roleHints": {
    "grunt": "-dev$",
    "security": "secur|cyber|threat"
  }
}
